{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "database.rules.json",
      ".firebaserc",
      "node_modules",
      "package.json",
      "package-lock.json",
      ".gitignore"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=3600"
          }
        ]
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}
