{
    "rules": {
        "rooms": {
            "$roomId": {
                ".read": true,
                ".write": "auth != null"
            }
        },
        "bankInfos": {
            "$roomId": {
                ".read": true,
                ".write": true
            }
        },
        "users": {
            "$uid": {
                ".read": "auth != null && auth.uid == $uid",
                ".write": "auth != null && auth.uid == $uid"
            }
        }
    }
}